# The domain people reach the server at. It cannot change later: passkeys are bound to it.
BRIGID_DOMAIN=id.example.org
# The image: a release (ghcr.io/brig-id/grove:vX.Y.Z), or one built from this repository.
GROVE_IMAGE=brigid/grove:dev
# Where the reverse proxy reaches grove, on this machine.
GROVE_PORT=8080
# An S3-compatible bucket for the replica of the database (Cloudflare R2, Backblaze B2, MinIO…).
REPLICA_ENDPOINT=https://<account>.r2.cloudflarestorage.com
REPLICA_BUCKET=grove-replica
